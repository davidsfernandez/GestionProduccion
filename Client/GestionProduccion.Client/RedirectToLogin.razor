@using GestionProduccion.Models.DTOs
@using System.Text.Json
@using GestionProduccion.Client.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject JsonSerializerOptions JsonOptions
@inject TvDetectionService TvDetection

<div class="vh-100 d-flex flex-column align-items-center justify-content-center bg-light animate-fade-in">
    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <h5 class="text-muted">@statusMessage</h5>
    @if (retryCount > 0)
    {
        <div class="badge bg-warning text-dark mt-2">Tentativa @retryCount/@MaxRetries</div>
    }
</div>

@code {
    private string statusMessage = "Verificando sistema...";
    private int retryCount = 0;
    private const int MaxRetries = 5;

    protected override async Task OnInitializedAsync()
    {
        // First check if it's a TV device to allow public access to dashboard
        var isTv = await TvDetection.IsTvDeviceAsync();
        if (isTv)
        {
            NavigationManager.NavigateTo("/tv-producao", true);
            return;
        }

        await CheckSetup();
    }

    private async Task CheckSetup()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<bool>>("api/auth/setup-required", JsonOptions);
            
            if (response != null && response.Success)
            {
                if (response.Data)
                {
                    NavigationManager.NavigateTo("/setup", true);
                }
                else
                {
                    NavigationManager.NavigateTo("/login", true);
                }
            }
            else
            {
                throw new Exception("Falha na resposta do servidor");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth Check Error: {ex.Message}");
            if (retryCount < MaxRetries)
            {
                retryCount++;
                statusMessage = "Conectando ao servidor...";
                await Task.Delay(2000 * retryCount);
                await CheckSetup();
            }
            else
            {
                statusMessage = "Erro de conexão. Por favor, verifique se o servidor está online.";
            }
        }
    }
}
