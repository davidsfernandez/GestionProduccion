@page "/catalogo"
@using GestionProduccion.Models.DTOs
@using Microsoft.AspNetCore.Authorization
@using GestionProduccion.Client.Services
@using System.Timers
@using System.Globalization
@attribute [Authorize(Roles = "Administrator,Leader")]
@inject IProductClient ProductClient
@inject IJSRuntime JS
@inject ToastService ToastService
@inject AudioService Audio
@implements IDisposable

<PageTitle>@Portuguese.Cat_Title</PageTitle>

<div class="container-fluid p-0 animate-fade-in">
    <div class="row mb-2 mb-xl-3">
        <div class="col-auto d-none d-sm-block">
            <h3 class="text-dark"><strong>@Portuguese.Cat_Title</strong></h3>
        </div>
        <div class="col-auto ms-auto text-end mt-n1">
            <button class="btn btn-primary shadow-sm" @onclick="() => OpenModal()">
                <i class="fa-solid fa-plus me-2"></i>@Portuguese.Cat_NewProduct
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden;">
                        <span class="input-group-text bg-white border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" class="form-control border-0 px-2" placeholder="@Portuguese.Cat_SearchHint" 
                               @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                    </div>
                </div>
            </div>

            @if (loading && allProducts == null)
            {
                <SeronaLoader />
            }
            else if (filteredProducts == null || !filteredProducts.Any())
            {
                <SeronaEmptyState 
                    Icon="fa-solid fa-shirt" 
                    Title="@Portuguese.Cat_NoProducts" 
                    Description="@(string.IsNullOrEmpty(searchTerm) ? "Seu catálogo de produtos está vazio." : "Nenhum produto corresponde à sua busca.")">
                    @if (string.IsNullOrEmpty(searchTerm))
                    {
                        <button class="btn btn-primary shadow-sm mt-3" @onclick="() => OpenModal()">
                            <i class="fa-solid fa-plus me-2"></i>@Portuguese.Cat_NewProduct
                        </button>
                    }
                </SeronaEmptyState>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover my-0 align-middle">
                        <thead>
                            <tr class="text-muted small uppercase fw-bold">
                                <th>SKU</th>
                                <th>@Portuguese.Cat_InternalCode</th>
                                <th>@Portuguese.Product</th>
                                <th>@Portuguese.Cat_FabricType</th>
                                <th class="text-center">@Portuguese.Cat_AvgTime</th>
                                <th class="text-end">@Portuguese.Cat_Price</th>
                                <th class="text-end">@Portuguese.Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in filteredProducts)
                            {
                                <tr @key="product.Id">
                                    <td><span class="badge bg-primary-soft text-primary px-2 py-1">@product.MainSku</span></td>
                                    <td><code class="text-dark fw-bold">@product.InternalCode</code></td>
                                    <td>
                                        <div class="fw-bold text-dark">@product.Name</div>
                                    </td>
                                    <td>@product.FabricType</td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <i class="fa-solid fa-clock-rotate-left text-muted me-2 small"></i>
                                            <span>@product.AverageProductionTimeMinutes.ToString("F1") min</span>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @product.EstimatedSalePrice.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-light me-1 shadow-none" @onclick="() => OpenModal(product)" title="@Portuguese.Edit">
                                            <i class="fa-solid fa-pen-to-square text-primary"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light shadow-none" @onclick="() => DeleteProduct(product)" title="@Portuguese.Delete">
                                            <i class="fa-solid fa-trash text-danger"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show d-block animate-fade-in" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary py-3 border-0">
                    <h5 class="modal-title text-white fw-bold">
                        <i class="fa-solid @(editingId == 0 ? "fa-plus-circle" : "fa-edit") me-2"></i>
                        @(editingId == 0 ? Portuguese.Cat_NewProduct : Portuguese.Cat_EditProduct)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <EditForm Model="@editingProduct" OnValidSubmit="SaveProduct" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        
                        <div class="row g-3">
                            <div class="col-md-12 mb-2">
                                <label class="form-label small fw-bold text-muted">@Portuguese.User_Name</label>
                                <InputText class="form-control form-control-lg border-2 shadow-none" @bind-Value="editingProduct.Name" placeholder="Ex: Camiseta Básica Masculina" />
                                <ValidationMessage For="@(() => editingProduct.Name)" class="text-danger xsmall mt-1" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">@Portuguese.Cat_InternalCode</label>
                                <InputText class="form-control border-2 shadow-none" @bind-Value="editingProduct.InternalCode" placeholder="Ex: 102030" />
                                <ValidationMessage For="@(() => editingProduct.InternalCode)" class="text-danger xsmall mt-1" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">@Portuguese.Cat_MainSku</label>
                                <InputText class="form-control border-2 shadow-none" @bind-Value="editingProduct.MainSku" placeholder="Ex: SKU-123" />
                                <ValidationMessage For="@(() => editingProduct.MainSku)" class="text-danger xsmall mt-1" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-muted">@Portuguese.Cat_FabricType</label>
                                <InputText class="form-control border-2 shadow-none" @bind-Value="editingProduct.FabricType" placeholder="Ex: Algodão 30.1 Penteado" />
                                <ValidationMessage For="@(() => editingProduct.FabricType)" class="text-danger xsmall mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">@Portuguese.Cat_AvgTimeMinutes</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2 border-end-0"><i class="fa-solid fa-clock"></i></span>
                                    <InputNumber class="form-control border-2 shadow-none border-start-0" @bind-Value="editingProduct.AverageProductionTimeMinutes" step="any" />
                                </div>
                                <ValidationMessage For="@(() => editingProduct.AverageProductionTimeMinutes)" class="text-danger xsmall mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">@Portuguese.Cat_EstPrice</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-2 border-end-0">R$</span>
                                    <InputNumber class="form-control border-2 shadow-none border-start-0" @bind-Value="editingProduct.EstimatedSalePrice" step="any" />
                                </div>
                                <ValidationMessage For="@(() => editingProduct.EstimatedSalePrice)" class="text-danger xsmall mt-1" />
                            </div>
                        </div>

                        <div class="modal-footer border-0 px-0 pb-0 mt-4">
                            <button type="button" class="btn btn-light px-4" @onclick="CloseModal" disabled="@isSaving">@Portuguese.Cancel</button>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>@Portuguese.OP_Saving</span>
                                }
                                else
                                {
                                    <span><i class="fa-solid fa-save me-2"></i>@Portuguese.Save</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto>? allProducts;
    private List<ProductDto>? filteredProducts;
    private string searchTerm = "";
    private bool showModal = false;
    private bool loading = true;
    private bool isSaving = false;
    private CreateProductDto editingProduct = new();
    private int editingId = 0;
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        debounceTimer = new Timer(300);
        debounceTimer.Elapsed += OnDebounceElapsed;
        debounceTimer.AutoReset = false;
    }

    private async Task LoadProducts()
    {
        try
        {
            loading = true;
            var response = await ProductClient.GetAllAsync();
            if (response != null && response.Success)
            {
                allProducts = response.Data;
                FilterProducts();
            }
            else
            {
                ToastService.ShowToast(response?.Message ?? Portuguese.Cat_ErrLoad, ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"{Portuguese.Cat_ErrLoad}: {ex.Message}", ToastLevel.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private void OnDebounceElapsed(object? sender, ElapsedEventArgs e)
    {
        InvokeAsync(() => {
            FilterProducts();
            StateHasChanged();
        });
    }

    private void FilterProducts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredProducts = allProducts;
        }
        else
        {
            filteredProducts = allProducts?
                .Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                            p.MainSku.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            p.InternalCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void OpenModal(ProductDto? product = null)
    {
        if (product != null)
        {
            editingId = product.Id;
            editingProduct = new CreateProductDto
            {
                Name = product.Name,
                InternalCode = product.InternalCode,
                FabricType = product.FabricType,
                MainSku = product.MainSku,
                EstimatedSalePrice = product.EstimatedSalePrice,
                AverageProductionTimeMinutes = product.AverageProductionTimeMinutes
            };
        }
        else
        {
            editingId = 0;
            editingProduct = new CreateProductDto { MainSku = "" };
        }
        showModal = true;
    }

    private void CloseModal()
    {
        if (!isSaving) showModal = false;
    }

    private void HandleInvalidSubmit()
    {
        ToastService.ShowToast(Portuguese.Cat_ErrValidationFields, ToastLevel.Warning, Portuguese.Cat_ErrValidation);
    }

    private async Task SaveProduct()
    {
        try
        {
            isSaving = true;
            ApiResponse<ProductDto> response;

            if (editingId == 0)
            {
                response = await ProductClient.CreateAsync(editingProduct);
            }
            else
            {
                var updateDto = new UpdateProductDto
                {
                    Id = editingId,
                    Name = editingProduct.Name,
                    InternalCode = editingProduct.InternalCode,
                    FabricType = editingProduct.FabricType,
                    MainSku = editingProduct.MainSku,
                    AverageProductionTimeMinutes = editingProduct.AverageProductionTimeMinutes,
                    EstimatedSalePrice = editingProduct.EstimatedSalePrice
                };
                response = await ProductClient.UpdateAsync(editingId, updateDto);
            }

            if (response.Success)
            {
                await Audio.PlaySuccess();
                ToastService.ShowToast(response.Message ?? Portuguese.Success, ToastLevel.Success);
                showModal = false;
                await LoadProducts();
            }
            else
            {
                await Audio.PlayError();
                ToastService.ShowToast(response.Message ?? "Erro ao salvar", ToastLevel.Error, Portuguese.Cat_ErrValidation);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ex.Message, ToastLevel.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteProduct(ProductDto product)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"{Portuguese.Cat_ConfirmDelete} ({product.Name})"))
        {
            try
            {
                var response = await ProductClient.DeleteAsync(product.Id);
                if (response.Success)
                {
                    ToastService.ShowToast(Portuguese.Cat_SuccessDeleted, ToastLevel.Success);
                    await LoadProducts();
                }
                else
                {
                    ToastService.ShowToast(response.Message ?? "Erro ao excluir", ToastLevel.Error);
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowToast(ex.Message, ToastLevel.Error);
            }
        }
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
