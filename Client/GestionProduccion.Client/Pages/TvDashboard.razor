@page "/tv-producao"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using GestionProduccion.Models.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@using GestionProduccion.Resources
@inject HttpClient Http
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<style>
    body {
        background-color: #f1f5f9; /* Clean industrial light gray */
        color: #1e293b;
        overflow: hidden;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }
    .tv-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 30px 50px;
        height: 12vh;
        background: #ffffff;
        border-bottom: 2px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .tv-logo {
        max-height: 75px;
        object-fit: contain;
    }
    .tv-clock {
        font-size: 3.8rem;
        font-weight: 800;
        letter-spacing: -1px;
        color: #0f172a;
    }
    .tv-content-area {
        height: 88vh;
        padding: 40px;
    }
    .tv-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 40px;
        height: 100%;
    }
    .tv-announcement-overlay {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: #0284c7; /* Vibrant blue for visibility */
        color: white;
        padding: 22px 0;
        font-size: 2.8rem;
        font-weight: 800;
        overflow: hidden;
        white-space: nowrap;
        z-index: 1000;
        box-shadow: 0 -10px 40px rgba(0,0,0,0.15);
    }
    .marquee {
        display: inline-block;
        padding-left: 100%;
        animation: marquee 25s linear infinite;
    }
    @@keyframes marquee {
        0%   { transform: translate(0, 0); }
        100% { transform: translate(-100%, 0); }
    }
    .tv-panel {
        background: #ffffff;
        border-radius: 35px;
        padding: 45px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 15px 45px rgba(0,0,0,0.07);
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
    }
    .tv-panel-header {
        font-size: 2.4rem;
        font-weight: 800;
        color: #64748b;
        margin-bottom: 35px;
        display: flex;
        align-items: center;
        gap: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .stat-value {
        font-size: 12rem;
        line-height: 0.9;
        font-weight: 900;
        text-align: center;
        margin: auto;
    }
    .color-success { color: #059669; }
    .color-warning { color: #d97706; }
    .color-info { color: #0284c7; }

    .list-item {
        font-size: 2.8rem;
        padding: 22px 0;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        color: #334155;
    }
    .list-item:last-child { border-bottom: none; }

    .offline-indicator {
        position: fixed;
        top: 25px;
        right: 25px;
        background: #dc2626;
        color: white;
        padding: 12px 25px;
        border-radius: 12px;
        font-weight: 900;
        font-size: 1.5rem;
        z-index: 2000;
        box-shadow: 0 10px 20px rgba(220,38,38,0.3);
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
</style>

@if (dashboard == null)
{
    <div class="d-flex justify-content-center align-items-center vh-100 bg-white">
        <div class="text-center">
            <div class="spinner-border text-primary mb-4" style="width: 6rem; height: 6rem; border-width: 0.5rem;" role="status"></div>
            <h2 class="text-muted fw-bold">SINCRONIZANDO MONITOR...</h2>
        </div>
    </div>
}
else
{
    <div class="tv-header">
        <div class="d-flex align-items-center">
            @if (!string.IsNullOrEmpty(publicConfig?.LogoBase64))
            {
                <img src="@publicConfig.LogoBase64" class="tv-logo me-4" alt="Logo" />
            }
            <h1 class="mb-0 fw-900" style="letter-spacing: -2px; font-weight: 900; font-size: 3rem;">MONITOR DE PRODUÇÃO</h1>
        </div>
        <div class="tv-clock">
            @currentTime.ToString("HH:mm:ss")
        </div>
    </div>

    <div class="tv-content-area">
        <div class="tv-container">
            <!-- P1: PRODUÇÃO DO DIA -->
            <div class="tv-panel">
                <div class="tv-panel-header"><i class="fa-solid fa-calendar-check color-success"></i> Produzido Hoje</div>
                <div class="stat-value color-success">@dashboard.CompletedToday</div>
                <div class="text-center text-muted h2 mt-3 fw-bold">Meta: @dashboard.DailyGoal Peças</div>
            </div>

            <!-- P2: EM CURSO -->
            <div class="tv-panel">
                <div class="tv-panel-header"><i class="fa-solid fa-spinner fa-spin color-info"></i> Lotes Ativos</div>
                <div style="overflow: hidden; flex: 1;">
                    @if (!dashboard.ProductionItems.Any())
                    {
                        <div class="h-100 d-flex align-items-center justify-content-center text-muted italic">
                            <h3>Aguardando início...</h3>
                        </div>
                    }
                    @foreach (var item in dashboard.ProductionItems.Take(4))
                    {
                        <div class="list-item animate-fade-in">
                            <div class="d-flex flex-column" style="max-width: 70%;">
                                <span class="text-truncate" style="font-size: 2.2rem;">@item.ProductName</span>
                                <small class="text-muted" style="font-size: 1.4rem; margin-top: -5px;">@item.LotCode • @TranslateStage(item.Stage)</small>
                            </div>
                            <div class="text-end">
                                <span class="color-info" style="font-size: 3.2rem;">@item.CurrentStageQuantity</span>
                                <span class="text-muted" style="font-size: 2rem;"> / @item.Quantity</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- P3: EFICIÊNCIA DIÁRIA -->
            <div class="tv-panel">
                <div class="tv-panel-header"><i class="fa-solid fa-bolt color-warning"></i> Eficiência do Turno</div>
                <div class="stat-value @(dashboard.CompletionRate >= 80 ? "color-success" : "color-warning")">
                    @dashboard.CompletionRate.ToString("0")%
                </div>
                <div class="progress mt-4" style="height: 20px; background: #f1f5f9; border-radius: 15px;">
                    <div class="progress-bar @(dashboard.CompletionRate >= 80 ? "bg-success" : "bg-warning")" 
                         style="width: @(Math.Min(100, dashboard.CompletionRate))%"></div>
                </div>
            </div>

            <!-- P4: MÉTRICAS DE TEMPO -->
            <div class="tv-panel">
                <div class="tv-panel-header"><i class="fa-solid fa-clock color-info"></i> Ritmo Médio</div>
                <div class="stat-value color-info">@dashboard.AverageTimePerPieceMinutes.ToString("F1")</div>
                <div class="text-center text-muted h2 mt-3 fw-bold">Minutos por Peça</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(dashboard.TvAnnouncement))
    {
        <div class="tv-announcement-overlay">
            <div class="marquee">
                <i class="fa-solid fa-bullhorn me-4"></i> @dashboard.TvAnnouncement 
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <i class="fa-solid fa-star me-4"></i> FOCO TOTAL NA META!
            </div>
        </div>
    }

    @if (!isConnected)
    {
        <div class="offline-indicator">
            <i class="fa-solid fa-wifi-slash me-2"></i> MONITOR OFFLINE
        </div>
    }
}

@code {
    private TvDashboardDto? dashboard;
    private PublicConfigurationDto? publicConfig;
    private HubConnection? hubConnection;
    private bool isConnected = false;
    private System.Threading.Timer? pollingTimer;
    private System.Threading.Timer? clockTimer;
    private DateTime currentTime = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadPublicConfig();
        await LoadData();
        await StartSignalR();
        
        pollingTimer = new System.Threading.Timer(async _ => await InvokeAsync(LoadData), null, 30000, 30000);
        clockTimer = new System.Threading.Timer(_ => { currentTime = DateTime.Now; InvokeAsync(StateHasChanged); }, null, 1000, 1000);
    }

    private async Task LoadPublicConfig()
    {
        try { publicConfig = await Http.GetFromJsonAsync<PublicConfigurationDto>("api/Configuration/public"); } catch { }
    }

    private async Task LoadData()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<TvDashboardDto>>("api/ProductionOrders/tv-stats");
            if (response != null && response.Success)
            {
                dashboard = response.Data;
                isConnected = true;
            }
        }
        catch { isConnected = false; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartSignalR()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.BaseUri + "productionHub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<int, string, string>("ReceiveUpdate", async (id, stage, status) => await InvokeAsync(LoadData));
        hubConnection.On<object>("ReceiveMessage", async (data) => await InvokeAsync(LoadData));

        try { await hubConnection.StartAsync(); isConnected = true; }
        catch { isConnected = false; }
    }

    private string TranslateStage(string stage) => stage.ToLower() switch
    {
        "cutting" => "Corte",
        "sewing" => "Costura",
        "review" => "Revisão",
        "packaging" => "Embalagem",
        _ => stage
    };

    public async ValueTask DisposeAsync()
    {
        if (pollingTimer != null) await pollingTimer.DisposeAsync();
        if (clockTimer != null) await clockTimer.DisposeAsync();
        if (hubConnection != null) await hubConnection.DisposeAsync();
    }
}
