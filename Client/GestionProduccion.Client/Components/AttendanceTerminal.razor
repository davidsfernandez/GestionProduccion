@using GestionProduccion.Models.DTOs
@using GestionProduccion.Client.Services.HR
@using GestionProduccion.Resources
@inject IAttendanceClient AttendanceClient
@inject ToastService ToastService

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-primary text-white p-4">
        <div class="d-flex align-items-center">
            <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                <i class="fa-solid fa-clock-rotate-left fa-2x"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold">Registro de Ponto</h4>
                <p class="mb-0 opacity-75 small">Sistema Brasileiro de Controle de Jornada</p>
            </div>
        </div>
    </div>
    
    <div class="card-body p-4 text-center">
        @if (isLoading)
        {
            <div class="py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted">Consultando status...</p>
            </div>
        }
        else
        {
            <div class="mb-4">
                <h1 class="display-4 fw-bold text-dark">@currentTime</h1>
                <p class="text-muted">@currentDate</p>
            </div>

            <div class="alert @(status?.IsClockedIn == true ? "alert-success" : "alert-light") border-0 rounded-3 mb-4">
                <i class="fa-solid @(status?.IsClockedIn == true ? "fa-circle-check" : "fa-circle-info") me-2"></i>
                <strong>Status Atual:</strong> @(status?.IsClockedIn == true ? "Trabalhando" : "Fora de Serviço")
                
                @if (status?.LastClockIn != null)
                {
                    <div class="mt-1 small opacity-75">
                        Última batida: @status.LastClockIn.Value.ToLocalTime().ToString("HH:mm:ss")
                    </div>
                }
            </div>

            <div class="d-grid gap-3">
                @if (status?.IsClockedIn == false)
                {
                    <button class="btn btn-primary btn-lg py-3 rounded-pill fw-bold" @onclick="HandleClockIn">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> REGISTRAR ENTRADA
                    </button>
                }
                else
                {
                    <button class="btn btn-danger btn-lg py-3 rounded-pill fw-bold" @onclick="HandleClockOut">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> REGISTRAR SAÍDA
                    </button>
                }
            </div>
            
            <div class="mt-4 p-3 bg-light rounded-3">
                <div class="small text-muted mb-1">Horas trabalhadas hoje:</div>
                <h5 class="mb-0 fw-bold text-primary">@status?.TodayHoursWorked.ToString("N2") h</h5>
            </div>
        }
    </div>
</div>

@code {
    private AttendanceStatusDto? status;
    private bool isLoading = true;
    private string currentTime = "";
    private string currentDate = "";
    private System.Timers.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        UpdateClock();
        timer = new System.Timers.Timer(1000);
        timer.Elapsed += (s, e) => {
            UpdateClock();
            InvokeAsync(StateHasChanged);
        };
        timer.Start();

        await LoadStatus();
    }

    private void UpdateClock()
    {
        var now = DateTime.Now;
        currentTime = now.ToString("HH:mm:ss");
        currentDate = now.ToString("D", new System.Globalization.CultureInfo("pt-BR"));
    }

    private async Task LoadStatus()
    {
        isLoading = true;
        var response = await AttendanceClient.GetStatusAsync();
        if (response.Success) status = response.Data;
        isLoading = false;
    }

    private async Task HandleClockIn()
    {
        isLoading = true;
        var response = await AttendanceClient.ClockInAsync();
        if (response.Success)
        {
            ToastService.ShowToast("Entrada registrada com sucesso!", ToastLevel.Success);
            await LoadStatus();
        }
        else
        {
            ToastService.ShowToast(response.Message ?? "Erro ao bater ponto.", ToastLevel.Error);
            isLoading = false;
        }
    }

    private async Task HandleClockOut()
    {
        isLoading = true;
        var response = await AttendanceClient.ClockOutAsync();
        if (response.Success)
        {
            ToastService.ShowToast("Saída registrada com sucesso!", ToastLevel.Success);
            await LoadStatus();
        }
        else
        {
            ToastService.ShowToast(response.Message ?? "Erro al registrar salida.", ToastLevel.Error);
            isLoading = false;
        }
    }

    public void Dispose() => timer?.Dispose();
}