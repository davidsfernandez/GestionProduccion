<div class="serona-loader-container">
    <div class="serona-spinner"></div>
</div>

<style>
    .serona-loader-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 3rem;
        width: 100%;
    }

    .serona-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(0, 200, 153, 0.1);
        border-left-color: var(--serona-primary, #00C899);
        border-radius: 50%;
        animation: serona-spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }

    @@keyframes serona-spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
</style>
